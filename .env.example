# Copy this file to .env and fill in your own ACRCloud credentials.
# .env is never committed and is never read from source code.
#
# Rotate any key that has been pasted into a chat, an issue tracker, a screenshot
# or a public repository. ACRCloud keys can be reset in the ACRCloud console.
ACRCLOUD_HOST=identify-ap-southeast-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=your_access_key_here
ACRCLOUD_ACCESS_SECRET=your_access_secret_here

# --- DARKNOTE AI ---------------------------------------------------------
# Provider key. Never hardcode this in source; it is read here or from
# config.json -> ai.apikey, and the environment always wins.
MZAZI_API_KEY=your_mzazi_api_key_here

# Optional overrides. Anything not set here falls back to config.json -> "ai".
# AI_CHATBOT_ENABLED=false
# AI_DM_ENABLED=true
# AI_GROUP_ENABLED=true
# AI_TYPING_ENABLED=true
# AI_MEMORY_ENABLED=true
# AI_RESPONSE_TIMING_ENABLED=true
# AI_REACTIONS_ENABLED=false
# AI_DM_DELAY=15
# AI_SHORT_DELAY=4
# AI_LONG_DELAY_MIN=13
# AI_LONG_DELAY_MAX=20
# AI_GROUP_DELAY_MIN=15
# AI_GROUP_DELAY_MAX=17
# AI_RATE_USER_PER_MIN=6
# AI_RATE_GROUP_PER_MIN=12
# AI_TIMEOUT_MS=60000
# AI_RETRIES=2

# Telegram control bot token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Key used for image generation / .edit re-edit. Falls back to MZAZI_API_KEY
# when unset. Never commit the real value.
MZAZI_API_KEY_IMAGE=

# Dedicated Mzazi Genius lyrics key. Used only by /api/lyrics/genius.
GENIUS_LYRICS_API_KEY=your_genius_mzazi_key_here

# --- YouTube audio (lib/ytdl.source.js) -----------------------------------
# From a datacenter IP, YouTube answers every player request with
# LOGIN_REQUIRED ("Sign in to confirm you're not a bot"), so .play, .song and
# .ytvideo cannot get a single format back. The fix is to give yt-dlp an account
# to act as, or an IP YouTube has not blocked.
#
# YTDLP_COOKIES: a Netscape-format cookies.txt exported from a browser signed in
#   to YouTube (use a "Get cookies.txt" style extension). A bare browser name
#   such as "chrome" works too, but only if that browser profile is on this host.
# YTDLP_PROXY: instead of cookies, a proxy URL YouTube has not rate-limited,
#   e.g. http://user:pass@host:port
# YTDLP_BIN: only needed when the yt-dlp binary is not on PATH.
# YTDLP_EXTRACTOR_ARGS: optional advanced override, e.g.
#   youtube:player_client=web_safari
#
# Cookies are credentials: keep this file out of git and rotate them if leaked.
#YTDLP_COOKIES=/absolute/path/to/cookies.txt
#YTDLP_PROXY=
#YTDLP_BIN=
#YTDLP_EXTRACTOR_ARGS=
